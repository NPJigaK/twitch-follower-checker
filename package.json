{
  "name": "twitch-follower-checker",
  "version": "2.2.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && next-sitemap",
    "compare:artifacts": "node scripts/compare-static-exports.mjs",
    "verify:artifact": "node scripts/verify-static-export.mjs",
    "verify:dependencies": "node scripts/verify-dependency-policy.mjs && node scripts/verify-dependency-resolutions.mjs",
    "start": "next start",
    "lint": "eslint . --ext .js --ext .mjs --ext .ts --ext .tsx --ignore-pattern .next --ignore-pattern out --ignore-pattern coverage",
    "test": "node --test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@material-tailwind/react": "2.1.9",
    "@mui/icons-material": "5.15.9",
    "@mui/material": "5.15.9",
    "ag-grid-community": "31.3.4",
    "ag-grid-react": "31.3.4",
    "classnames": "2.3.2",
    "next": "14.1.0",
    "next-sitemap": "4.2.3",
    "nextra": "3.0.0-alpha.12",
    "nextra-theme-docs": "3.0.0-alpha.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-social-login-buttons": "3.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "18.2.42",
    "@types/react-dom": "18.2.19",
    "autoprefixer": "10.4.16",
    "eslint": "8.56.0",
    "eslint-config-next": "14.0.3",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.2"
  },
  "resolutions": {
    "postcss": "8.5.28"
  }
}
