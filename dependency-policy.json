    "classnames": "2.5.1",
    "next": "15.0.0",
    "nextra": "3.3.1",
    "nextra-theme-docs": "3.3.1",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19"
  },
  "singleResolutionPackages": [
    "@material-tailwind/react",
    "@mui/icons-material",
    "@mui/material",
    "ag-grid-community",
    "ag-grid-react",
    "autoprefixer",
    "next",
    "nextra",
    "nextra-theme-docs",
    "postcss",
    "react",
    "react-dom",
    "tailwindcss",
    "typescript"
  ],
